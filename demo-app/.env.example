# Demo Authentication App Configuration
# Set explicitly to 'development', 'test', or 'production'
NODE_ENV=development
PORT=3000

# Required in production: minimum 32 characters, high entropy, no placeholders
JWT_SECRET=<generate_a_cryptographically_secure_random_jwt_secret_min_32_chars>
TOKEN_HMAC_SECRET=<generate_a_cryptographically_secure_random_hmac_secret_min_32_chars>

# Trusted frontend origins for CORS (comma-separated, required in production, no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5000

# TokenLine Event Collector URL and Optional Ingest API Key
COLLECTOR_URL=http://127.0.0.1:5000/events
# COLLECTOR_API_KEY=<optional_collector_ingest_api_key_min_16_chars>
