{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TokenLineEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "type": "string",
      "maxLength": 128
    },
    "event_type": {
      "type": "string",
      "enum": [
        "token_issued",
        "token_used",
        "token_refreshed",
        "token_revoked",
        "token_expired",
        "logout",
        "refresh_reuse_detected",
        "suspicious_location",
        "suspicious_device",
        "replay_detected",
        "login_failed",
        "token_rejected"
      ]
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "maxLength": 64
    },
    "user_id": {
      "type": "string",
      "maxLength": 128
    },
    "token_hash": {
      "type": "string",
      "pattern": "^(hash_)?[0-9a-fA-F]{12,64}$",
      "maxLength": 128
    },
    "token_family": {
      "type": "string",
      "maxLength": 128
    },
    "parent_token_hash": {
      "type": ["string", "null"],
      "pattern": "^(hash_)?[0-9a-fA-F]{12,64}$",
      "maxLength": 128
    },
    "ip_hash": {
      "type": "string",
      "pattern": "^(hash_)?[0-9a-fA-F]{12,64}$",
      "maxLength": 128
    },
    "country": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "maxLength": 2
    },
    "device_id": {
      "type": "string",
      "maxLength": 128
    },
    "user_agent_family": {
      "type": "string",
      "maxLength": 128
    },
    "endpoint": {
      "type": "string",
      "maxLength": 512
    },
    "result": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected"
      ]
    }
  },
  "required": [
    "event_id",
    "event_type",
    "time",
    "user_id",
    "token_hash",
    "ip_hash",
    "device_id",
    "result"
  ],
  "additionalProperties": false
}
