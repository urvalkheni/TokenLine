# ==============================================================================
# TokenLine Event Collector Environment Configuration
# ==============================================================================

# Environment mode: 'development', 'test', or 'production' (default in production if unset)
# In development/test mode: safe default fallback credentials and CORS allowlists are enabled.
# In production mode: strong credentials (>=16 chars) and explicit CORS origins are strictly required.
TOKENLINE_ENV=development

# Event Collector HTTP server port (default: 5000)
PORT=5000

# Database Storage URL
# Default local storage: SQLite file in repository root
DATABASE_URL=sqlite:///./tokenline.db

# Switch to Neon / Hosted PostgreSQL by setting your connection string:
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require

# ==============================================================================
# API Credentials (REQUIRED in production mode; minimum 16 characters; no published defaults)
# Supported roles: admin, ingest, read
# In development mode, leaving these unset defaults to:
#   admin:  tokenline-admin-secret
#   ingest: tokenline-ingest-secret
#   read:   tokenline-read-secret
# ==============================================================================
# COLLECTOR_ADMIN_API_KEY=<generate_strong_admin_api_key_min_16_chars>
# COLLECTOR_INGEST_API_KEY=<generate_strong_ingest_api_key_min_16_chars>
# COLLECTOR_READ_API_KEY=<generate_strong_read_api_key_min_16_chars>

# Or specify as a JSON mapping of { "api-key": "role" }:
# COLLECTOR_API_KEYS={"<your_admin_key>":"admin","<your_ingest_key>":"ingest","<your_read_key>":"read"}

# ==============================================================================
# CORS Configuration (REQUIRED in production mode; explicit allowlist; no wildcards)
# Comma-separated list of trusted frontend origins
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5000
