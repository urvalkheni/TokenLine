# ==============================================================================
# TokenLine Event Collector Environment Configuration
# ==============================================================================

# Environment mode: 'development', 'test', or 'production' (default in production if unset)
TOKENLINE_ENV=development

# Event Collector HTTP server port
PORT=5000

# Leave unset (or use the SQLite default below) for local dev
DATABASE_URL=sqlite:///./tokenline.db

# Set this to switch to Neon — get the connection string from your Neon project dashboard
# DATABASE_URL=postgresql://<user>:<password>@<neon-host>/<db>?sslmode=require

# ==============================================================================
# API Credentials (REQUIRED in production; min 16 chars; no published defaults)
# Supported roles: admin, ingest, read
# ==============================================================================
COLLECTOR_ADMIN_API_KEY=<generate_strong_admin_api_key_min_16_chars>
COLLECTOR_INGEST_API_KEY=<generate_strong_ingest_api_key_min_16_chars>
COLLECTOR_READ_API_KEY=<generate_strong_read_api_key_min_16_chars>

# Or as a JSON mapping of { "api-key": "role" }:
# COLLECTOR_API_KEYS={"<your_admin_key>":"admin","<your_ingest_key>":"ingest","<your_read_key>":"read"}

# ==============================================================================
# CORS Configuration (REQUIRED in production; explicit allowlist; no wildcards)
# Comma-separated list of trusted frontend origins
# ==============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:5000
